{
  "name": "expo-scroll-edge-effect-example",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:tailscale": "REACT_NATIVE_PACKAGER_HOSTNAME=$(/Applications/Tailscale.app/Contents/MacOS/Tailscale ip -4) expo start --dev-client --host lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "start:tunnel": "expo start --dev-client --tunnel"
  },
  "dependencies": {
    "expo": "~57.0.19",
    "expo-dev-client": "~57.0.18",
    "expo-glass-effect": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "@expo/ngrok": "npm:expo-cloudflared@^4.2.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
